# Clodsite credential registry — copy to .env and fill in your values.
#
# .env is gitignored; never commit real values, never paste them into chat.
# Sites reference these env-var NAMES from build-plan.yaml — the values live
# only here. Inspect what a site resolves to with:
#   source scripts/resolve-env.sh <site>
#
# Multiple checkouts/worktrees under one operator account: keep a single file at
# ~/.config/clodsite/env and symlink each checkout's .env to it:
#   ln -sf ~/.config/clodsite/env <checkout>/.env
# ============================================================================

# ── Operator / Cloudflare (required) ──
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Workspace (optional; defaults to ./sites) ──
# SITES_DIR=/path/to/your/sites/repo

# ── Stripe (commerce checkout) ──
# Single mode: set STRIPE_SECRET_KEY and leave commerce.checkout.mode unset.
# Per-site mode (item 12): keep BOTH keys here; each plan picks one with
#   commerce.checkout.mode: test|live   → STRIPE_SECRET_KEY_{TEST,LIVE}
# STRIPE_SECRET_KEY=
# STRIPE_SECRET_KEY_TEST=
# STRIPE_SECRET_KEY_LIVE=

# ── Printful (commerce fulfillment) ──
# Single store: set PRINTFUL_API_KEY.
# Multiple stores (item 12): give each store its own name and bind it per site
# with  commerce.printful.api_key_env: <NAME>   (e.g. ACME_PRINTFUL_API_KEY).
# PRINTFUL_API_KEY=

# ── Resend (contact forms + manual-provider order emails) ──
# RESEND_API_KEY=
# Per-site override (item 12): resend-form api_key_env: <NAME>.

# ── Proxy bearer secrets ──
# One per build-plan.yaml proxies[].secret, named exactly as the plan declares:
# MYPROXY_API_KEY=
