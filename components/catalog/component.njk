{# Receives component.products: resolved product objects embedded at render
   time by render-templates (catalog.json ⋈ plan filter). Display fields only —
   variants and fulfillment refs never reach the page. #}
<div class="c-catalog" data-randomize-initial-color="{% if component.randomize_initial_color %}true{% else %}false{% endif %}">
  {% for product in component.products %}
  <article class="c-catalog__product{% if not (product.images and product.images.main) %} c-catalog__product--no-media{% endif %}" data-slug="{{ product.slug | escape }}"
           data-name="{{ product.name | escape }}" data-price-minor="{{ product.price_minor }}"
           {% if product.images and product.images.main %}data-image="{{ product.images.main | escape }}"{% endif %}>
    {% if product.images and product.images.main %}
    <figure class="c-catalog__media">
      <img class="c-catalog__image" src="{{ product.images.main | escape }}" alt="{{ product.name | escape }}" loading="lazy">
      {% if product.images.has_views %}
      <div class="c-catalog__view-toggle" role="group" aria-label="{{ product.name | escape }} view">
        <button type="button" class="c-catalog__view-button" data-view="front" aria-pressed="true">Front</button>
        <button type="button" class="c-catalog__view-button" data-view="back" aria-pressed="false">Back</button>
      </div>
      {% endif %}
    </figure>
    {% endif %}
    <div class="c-catalog__body">
      <h3 class="c-catalog__name">{{ product.name | escape }}</h3>
      <p class="c-catalog__price">{{ product.price_display | escape }}{% if product.size %} <span class="c-catalog__size">{{ product.size | escape }}</span>{% endif %}</p>
      <p class="c-catalog__description">{{ product.description | escape }}</p>
      {% for option in product.options %}
      <div class="c-catalog__option" data-option-name="{{ option.name | escape }}">
        <span class="c-catalog__option-name" id="catalog-{{ product.slug | escape }}-opt-{{ loop.index0 }}">{{ option.name | escape }}</span>
        {% if loop.index0 == 0 and option.has_swatches %}
        <div class="c-catalog__swatches" role="group" aria-labelledby="catalog-{{ product.slug | escape }}-opt-{{ loop.index0 }}">
          {% for value in option.values %}
          {% set swatchImage = product.images and product.images.main %}
          {% if not loop.first and product.images and product.images.gallery and product.images.gallery[loop.index0 - 1] %}
          {% set swatchImage = product.images.gallery[loop.index0 - 1] %}
          {% endif %}
          {% set swatchViews = product.images and product.images.by_color and product.images.by_color[value.value] %}
          <button type="button" class="c-catalog__swatch" title="{{ value.value | escape }}"
                  aria-label="{{ value.value | escape }}" aria-pressed="{% if loop.first %}true{% else %}false{% endif %}"
                  {% if swatchImage %}data-src="{{ swatchImage | escape }}"{% endif %}
                  {% if swatchViews and swatchViews.front %}data-view-front="{{ swatchViews.front | escape }}"{% endif %}
                  {% if swatchViews and swatchViews.back %}data-view-back="{{ swatchViews.back | escape }}"{% endif %}
                  style="background-color: {{ value.hex | escape }}"></button>
          {% endfor %}
        </div>
        {% else %}
        <select class="c-catalog__select" aria-labelledby="catalog-{{ product.slug | escape }}-opt-{{ loop.index0 }}">
          {% for value in option.values %}
          <option value="{{ value.value | escape }}">{{ value.value | escape }}</option>
          {% endfor %}
        </select>
        {% endif %}
      </div>
      {% endfor %}
      {% if site.commerce.cart_enabled %}
      <div class="c-catalog__add">
        <button type="button" class="c-catalog__add-button">Add to cart</button>
        <span class="c-catalog__add-flash" role="status" hidden>Unavailable</span>
      </div>
      {% endif %}
      {% if product.size_guide %}
      <button type="button" class="c-catalog__size-guide-open">Size guide</button>
      <dialog class="c-catalog__size-guide" aria-label="{{ product.name | escape }} size guide">
        <div class="c-catalog__size-guide-header">
          <h4>Size guide <span class="c-catalog__size-guide-unit">({{ product.size_guide.unit | escape }})</span></h4>
          <button type="button" class="c-catalog__size-guide-close" aria-label="Close">&times;</button>
        </div>
        {% if product.size_guide.tables.length > 1 %}
        <div class="c-catalog__size-guide-tabs" role="tablist">
          {% for table in product.size_guide.tables %}
          <button type="button" class="c-catalog__size-guide-tab" role="tab"
                  aria-selected="{% if loop.first %}true{% else %}false{% endif %}">{{ table.label | escape }}</button>
          {% endfor %}
        </div>
        {% endif %}
        {% for table in product.size_guide.tables %}
        <section class="c-catalog__size-guide-panel"{% if not loop.first %} hidden{% endif %}>
          {% if product.size_guide.tables.length == 1 %}
          <h5 class="c-catalog__size-guide-label">{{ table.label | escape }}</h5>
          {% endif %}
          {% if table.diagram %}
          <div class="c-catalog__size-guide-diagram">
            <img src="{{ table.diagram.image | escape }}" alt="Measurement diagram" loading="lazy">
            <ol class="c-catalog__size-guide-steps">
              {% for step in table.diagram.steps %}
              <li><strong>{{ step.label | escape }}</strong> {{ step.text | escape }}</li>
              {% endfor %}
            </ol>
          </div>
          {% endif %}
          <table class="c-catalog__size-guide-table">
            <thead>
              <tr>
                <th></th>
                {% for size, value in table.rows[0].values %}<th>{{ size | escape }}</th>{% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for row in table.rows %}
              <tr>
                <th scope="row">{{ row.label | escape }}</th>
                {% for size, value in table.rows[0].values %}<td>{{ row.values[size] | escape }}</td>{% endfor %}
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if table.note %}
          <p class="c-catalog__size-guide-note">{{ table.note | escape }}</p>
          {% endif %}
        </section>
        {% endfor %}
      </dialog>
      {% endif %}
    </div>
  </article>
  {% endfor %}
  <script>
    (function () {
      var catalog = document.currentScript.closest('.c-catalog');
      for (var card of catalog.querySelectorAll('.c-catalog__product')) {
        (function (card) {
          var mainImage = card.querySelector('.c-catalog__image');
          var swatches = card.querySelectorAll('.c-catalog__swatch');
          var viewButtons = card.querySelectorAll('.c-catalog__view-button');
          var selectedView = 'front';
          function viewImage(swatch, view) {
            if (!swatch) return '';
            if (view === 'back' && swatch.dataset.viewBack) return swatch.dataset.viewBack;
            return swatch.dataset.viewFront || swatch.dataset.src || '';
          }
          function activeSwatch() {
            return card.querySelector('.c-catalog__swatch[aria-pressed="true"]');
          }
          function syncViewButtons(swatch) {
            for (var button of viewButtons) {
              var view = button.dataset.view;
              var available = Boolean(viewImage(swatch, view));
              button.disabled = !available;
              button.setAttribute('aria-pressed', String(view === selectedView && available));
            }
          }
          function showImage(swatch) {
            if (!mainImage || !swatch) return;
            if (!viewImage(swatch, selectedView)) selectedView = 'front';
            var src = viewImage(swatch, selectedView);
            if (src) {
              mainImage.src = src;
              card.dataset.image = src;
            }
            syncViewButtons(swatch);
          }
          function selectSwatch(swatch) {
            if (!swatch) return;
            for (var s of swatches) s.setAttribute('aria-pressed', String(s === swatch));
            showImage(swatch);
          }
          for (var swatch of swatches) {
            swatch.addEventListener('click', function (e) {
              selectSwatch(e.currentTarget);
            });
          }
          for (var viewButton of viewButtons) {
            viewButton.addEventListener('click', function (e) {
              if (e.currentTarget.disabled) return;
              selectedView = e.currentTarget.dataset.view;
              showImage(activeSwatch());
            });
          }
          syncViewButtons(activeSwatch());
          if (catalog.dataset.randomizeInitialColor === 'true' && swatches.length > 1) {
            selectSwatch(swatches[Math.floor(Math.random() * swatches.length)]);
          }
          var addButton = card.querySelector('.c-catalog__add-button');
          if (addButton) {
            var flash = card.querySelector('.c-catalog__add-flash');
            var flashTimer = null;
            addButton.addEventListener('click', function () {
              // Collect selections in DOM order — the declared option order,
              // matching the catalog set keys the cart validates against.
              var optionValues = {};
              for (var wrapper of card.querySelectorAll('.c-catalog__option')) {
                var select = wrapper.querySelector('.c-catalog__select');
                var pressed = wrapper.querySelector('.c-catalog__swatch[aria-pressed="true"]');
                optionValues[wrapper.dataset.optionName] =
                  select ? select.value : pressed.getAttribute('aria-label');
              }
              var cart = window.__clodsiteCart;
              if (!cart || !cart.sells(card.dataset.slug, optionValues)) {
                flash.hidden = false;
                clearTimeout(flashTimer);
                flashTimer = setTimeout(function () { flash.hidden = true; }, 2000);
                return;
              }
              document.dispatchEvent(new CustomEvent('clodsite:cart:add', {
                detail: {
                  slug: card.dataset.slug,
                  name: card.dataset.name,
                  price_minor: parseInt(card.dataset.priceMinor, 10),
                  image: card.dataset.image,
                  optionValues: optionValues
                }
              }));
            });
          }
          var openBtn = card.querySelector('.c-catalog__size-guide-open');
          if (openBtn) {
            var dialog = card.querySelector('.c-catalog__size-guide');
            openBtn.addEventListener('click', function () { dialog.showModal(); });
            dialog.querySelector('.c-catalog__size-guide-close')
              .addEventListener('click', function () { dialog.close(); });
            dialog.addEventListener('click', function (e) {
              if (e.target === dialog) dialog.close();
            });
            var tabs = dialog.querySelectorAll('.c-catalog__size-guide-tab');
            var panels = dialog.querySelectorAll('.c-catalog__size-guide-panel');
            tabs.forEach(function (tab, index) {
              tab.addEventListener('click', function () {
                tabs.forEach(function (t, i) {
                  t.setAttribute('aria-selected', String(i === index));
                  panels[i].hidden = (i !== index);
                });
              });
            });
          }
        })(card);
      }
    })();
  </script>
</div>
